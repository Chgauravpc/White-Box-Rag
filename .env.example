# Copy this file to .env and fill in your values
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
CHROMA_PATH=./data/chromadb
SQLITE_PATH=./data/metadata.db

# ---------- Multi-key LLM pool (Phase 2) — optional, see backend/shared/llm_pool_config.py ----------
# Comma-separated key lists. If unset, the pool falls back to the single
# GROQ_API_KEY / OPENROUTER_API_KEY above (a "pool of one" — no behavior
# change unless you actually add more keys).
# GROQ_API_KEYS=key1,key2,key3
# OPENROUTER_API_KEYS=key1,key2

# Which provider(s) the pool talks to, in priority order. Defaults to just
# LLM_PROVIDER above (single-provider, same as pre-pool behavior) — list
# more than one only once you want cross-provider failover.
# LLM_PROVIDER_ORDER=groq,openrouter
# LLM_ALLOW_CROSS_PROVIDER_FAILOVER=false
# For published benchmark runs: forbid a failover that would silently swap
# which model produced an item mid-run (an item hits CAPACITY_EXHAUSTED and
# gets re-run later instead of contaminating the number with a different model).
# LLM_STRICT_SINGLE_MODEL=false

# Per-key rate limits — SET THESE FROM YOUR ACTUAL PLAN TIER. The defaults
# below are conservative placeholders, not a promise about your account.
# GROQ_RPM_PER_KEY=30
# GROQ_TPM_PER_KEY=6000
# OPENROUTER_RPM_PER_KEY=20
# OPENROUTER_TPM_PER_KEY=60000
# LLM_MAX_CONCURRENCY_PER_KEY=2

# live (default) | record | replay — see backend/shared/llm_cassette.py.
# record/replay make eval runs bit-reproducible and let CI run the full
# pipeline with zero API keys.
# LLM_MODE=live
# LLM_CASSETTE_DIR=eval/cassettes

# Scale eval-harness item concurrency to the pool's total call-level
# capacity instead of the static EVAL_CONCURRENCY below (only useful once
# you actually have more than one key).
# EVAL_CONCURRENCY_AUTO=false

# ---------- NLI premise normalization ----------
# none | generic (default) | financial_reports — see backend/shared/text_normalize.py
PREMISE_NORMALIZER=generic

# ---------- Compliance domain profile ----------
# generic (default) | financial_reports — see backend/compliance/domain_profiles.py
DOMAIN_PROFILE=generic

# ---------- Everything below is optional: every value already has a ----------
# ---------- behavior-preserving default in backend/shared/config.py  ----------

# Retrieval depth
# DENSE_TOP_K=20
# SPARSE_TOP_K=20
# FINAL_TOP_K=10
# RRF_K=60

# Sentence / NLI preprocessing
# MIN_SENTENCE_LEN=20
# NLI_TOP_K=3
# NLI_PREPROCESS_AT=60

# Attribution thresholds
# MIN_ATTRIBUTION_SCORE=0.45
# AMBIGUITY_GAP_THRESHOLD=0.02
# WEAK_ATTRIBUTION_SCORE=0.65

# Trust Gate / Shapley penalty weights (trust_gate.py and xai_matrices.py
# apply the SAME values so their overall_score can't drift apart)
# PENALTY_EDITION_CONFLICT=0.5
# PENALTY_CONTRADICTION=0.30
# PENALTY_NEUTRAL=0.10
# PENALTY_LOW_CONFIDENCE=0.20
# PENALTY_MID_CONFIDENCE=0.05
# PENALTY_AMBIGUOUS_ATTRIBUTION=0.05
# PENALTY_WEAK_ATTRIBUTION=0.03
# LOW_CONFIDENCE_CEIL=0.5
# MID_CONFIDENCE_CEIL=0.8

# Mitigation / abstention
# STRIP_ENTAILMENT_FLOOR=0.5
# ABSTENTION_MEAN_PENALTY_CEIL=0.25

# Edition conflict detection
# CONFLICT_PREFILTER_COSINE=0.90
# CONFLICT_CONTRADICTION_THRESHOLD=0.70
# MAX_CONFLICT_CHECKS_PER_QUERY=5

# Generation sampling
# GENERATION_TEMPERATURE=0.2
# COMPLIANCE_TEMPERATURE=0.1
# STABILITY_TEMPERATURE=0.7
# Best-effort determinism hint sent to the LLM provider's `seed` param.
# Unset (default) = don't send one. Not a reproducibility guarantee by itself.
# GLOBAL_SEED=1234

# Eval harness
# EVAL_CONCURRENCY=3

# Model identities — pin a `*_REVISION` only once you've verified a specific
# HF commit/tag works for you; unpinned (default) tracks the mutable branch.
# XAI_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# XAI_EMBEDDING_MODEL_REVISION=
# NLI_MODEL=cross-encoder/nli-deberta-v3-base
# NLI_MODEL_REVISION=
# CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2
# SPACY_MODEL=en_core_web_sm
